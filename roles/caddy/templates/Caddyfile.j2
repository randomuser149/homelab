{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

{{ vaultwarden_domain }}.{{ tld }} {
	reverse_proxy vaultwarden:{{ vaultwarden_port }}
}

{{ influx_domain }}.{{ tld }} {
	reverse_proxy influxdb:{{ influx_port }}
}

{{ grafana_domain }}.{{ tld }} {
	@public {
		path /public-dashboards/*
		path /api/public/dashboards/*
		path /public/build/*
		path /public/img/*
	}
	handle @public {
		reverse_proxy grafana:{{ grafana_port }}
	}
	respond * 403
}

http://{{ server_ip }}, http://{{ server_tailscale_ip}} {
	reverse_proxy grafana:{{ grafana_port }}
}


:{{ caddy_health_port }}, http://{{ server_ip }}:{{ caddy_health_port }}, http://{{ server_tailscale_ip}}:{{ caddy_health_port }} {
        respond /health 200 {
                body "OK"
        }
}


{{ tandoor_domain }}.{{ tld }} {
	encode zstd gzip
	
	reverse_proxy web_recipes:80 {
		header_up Host {{ tandoor_domain }}.{{ tld }}
	    header_up X-Forwarded-For {remote_host}
	}
}

{{ davical_domain }}.{{ tld }} {
	reverse_proxy davical:80 {
	    header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-For {remote}
    }
}
